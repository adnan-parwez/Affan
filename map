    )
    
    # Add information box
    ax.annotate(
        info_text,
        xy=(web_lon, web_lat),
        xytext=(box_x, box_y),
        textcoords="offset points",
        fontsize=9,
        fontweight='bold',
        color='#1a1a1a',
